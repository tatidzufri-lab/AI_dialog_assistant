BOT_TOKEN=your_telegram_bot_token
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/retreat
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1
RETREAT_TOPIC=Ретрит «Познай себя»
# Оставьте RETREAT_MATERIAL пустым, чтобы использовать дефолтный брендовый контент
# из config/settings.py, или задайте свой короткий текст либо путь к файлу:
# RETREAT_MATERIAL_FILE=./retreat_material.txt
# AUDIENCE_PORTRAITS_FILE=./audience_portraits.txt
REFLECTION_QUESTION_COUNT=5
# Запрещённые слова бренда (через запятую), проверяются в ответе модели:
FORBIDDEN_WORDS=успех,прорыв,гарантированный результат,быстрый эффект,навсегда изменим жизнь
# Кризисные ключевые слова (через запятую). При их появлении диалог останавливается
# и участнице отправляется CRISIS_RESPONSE с контактами специалистов.
CRISIS_KEYWORDS=суицид,покончить с собой,не хочу жить,хочу умереть,убить себя
# Бот-консультант, которому передаются участницы для реальной записи на ретрит.
# BOOKING_BOT_USERNAME — без @, только ник. BOOKING_BOT_DISPLAY_NAME — имя в именительном
# падеже (для фраз «Дальше тебя встретит …»). BOOKING_BOT_DATIVE_NAME — имя в дательном
# падеже (для кнопки и фразы «Перейти к …»), чтобы согласование было естественным.
BOOKING_BOT_USERNAME=retreat_poznai_bot
BOOKING_BOT_DISPLAY_NAME=Лея
BOOKING_BOT_DATIVE_NAME=Лее
LOG_LEVEL=INFO
